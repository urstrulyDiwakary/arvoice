<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/disposition_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg">

    <RelativeLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/dim_8">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24dp" />

        <TextView
            android:id="@+id/tvHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/dim_4"
            android:text="Disposition"
            android:textColor="@color/black"
            android:textSize="@dimen/dim_16"
            android:textStyle="bold" />


    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_below="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/layout_root"
            android:padding="@dimen/dim_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                card_view:cardCornerRadius="12dp"
                android:elevation="@dimen/dim_8"
                android:id="@+id/cvContent"
                card_view:cardElevation="8dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/dim_12"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="Was call connected?"
                        android:textSize="@dimen/dim_16"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_marginTop="@dimen/dim_12"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_not_connected"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="Not Connected"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:backgroundTint="#FF3B30" />

                        <Button
                            android:id="@+id/btn_connected"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Yes Connected"
                            android:textAllCaps="false"
                            android:backgroundTint="#E0E0E0"
                            android:textColor="#000000" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- Call Status -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                card_view:cardCornerRadius="12dp"
                android:elevation="@dimen/dim_8"
                android:id="@+id/cvReason"
                card_view:cardElevation="8dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/dim_12"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/layout_not_connected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/dim_16"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:text="Please specify the reason?" />

                        <RadioGroup
                            android:id="@+id/radio_group_reasons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp">

                            <RadioButton
                                android:id="@+id/radio_user_did_not_pick"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/dim_14"
                                android:textColor="@color/black"
                                android:buttonTint="@color/colorPrimary"
                                android:text="User did not pick" />

                            <RadioButton
                                android:id="@+id/radio_busy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/dim_14"
                                android:textColor="@color/black"
                                android:buttonTint="@color/colorPrimary"
                                android:text="Busy in another call" />

                            <RadioButton
                                android:id="@+id/radio_disconnected"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/colorPrimary"
                                android:textSize="@dimen/dim_14"
                                android:textColor="@color/black"
                                android:text="Disconnected the call" />

                            <RadioButton
                                android:id="@+id/radio_coverage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/dim_14"
                                android:textColor="@color/black"
                                android:buttonTint="@color/colorPrimary"
                                android:text="Out of coverage area" />

                            <RadioButton
                                android:id="@+id/radio_switched_off"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/dim_14"
                                android:textColor="@color/black"
                                android:buttonTint="@color/colorPrimary"
                                android:text="Number switched off" />

                            <RadioButton
                                android:id="@+id/radio_incorrect"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/dim_14"
                                android:textColor="@color/black"
                                android:buttonTint="@color/colorPrimary"
                                android:text="Incorrect number" />

                            <RadioButton
                                android:id="@+id/radio_unavailable"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/dim_14"
                                android:textColor="@color/black"
                                android:buttonTint="@color/colorPrimary"
                                android:text="Option not available" />
                        </RadioGroup>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- Not Connected Section -->

            <!-- Connected Section -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:visibility="gone"
                card_view:cardCornerRadius="12dp"
                android:elevation="@dimen/dim_8"
                android:id="@+id/cvConnected"
                card_view:cardElevation="8dp">



                <LinearLayout
                    android:id="@+id/layout_connected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dim_12"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/dim_16"
                        android:text="Update form data" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_12"
                        android:textColor="@color/black"
                        android:text="Expected Revenue"/>

                    <EditText
                        android:id="@+id/input_revenue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/dim_16"
                        android:textColor="@color/black"
                        android:inputType="numberDecimal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_12"
                        android:textColor="@color/black"
                        android:text="Expected Closing Date"/>

                    <EditText
                        android:id="@+id/input_closing_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_12"
                        android:textSize="@dimen/dim_16"
                        android:textColor="@color/black"
                        android:focusable="false"
                        android:inputType="none"
                        android:drawableTint="@color/colorPrimary"
                        android:drawableEnd="@drawable/baseline_calendar_month_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_12"
                        android:textColor="@color/black"
                        android:text="Lead Stage"/>

                    <EditText
                        android:focusableInTouchMode="false"
                        android:id="@+id/etLeadState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dim_12"
                        android:textSize="@dimen/dim_16"
                        android:textColor="@color/black"
                        android:focusable="false"
                        android:clickable="true"
                        android:inputType="none"
                        android:drawableEnd="@drawable/baseline_arrow_drop_down_24" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:visibility="visible"
                card_view:cardCornerRadius="12dp"
                android:elevation="@dimen/dim_8"
                card_view:cardElevation="8dp">



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/dim_12"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:paddingVertical="16dp">

                    <!-- Follow-up Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select next action"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="@dimen/dim_16" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dim_12"
                            android:textColor="@color/black"
                            android:text="Next Follow-uo On"/>

                        <LinearLayout
                            android:layout_marginTop="@dimen/dim_12"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">



                            <EditText
                                android:id="@+id/input_followup_date"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:focusableInTouchMode="false"
                                android:hint="Select Date &amp; Time"
                                android:textSize="@dimen/dim_16"
                                android:focusable="false"
                                android:clickable="true"
                                android:inputType="none"
                                android:drawableTint="@color/colorPrimary"
                                android:drawableEnd="@drawable/baseline_calendar_month_24" />

                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dim_12"
                            android:textColor="@color/black"
                            android:text="Next Follow-uo Notes"/>

                        <EditText
                            android:layout_marginTop="@dimen/dim_12"
                            android:id="@+id/input_notes"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:gravity="top"
                            android:background="@android:drawable/edit_text" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>




            <LinearLayout
                android:layout_width="match_parent"
                android:padding="@dimen/dim_10"
                android:layout_height="wrap_content">

                <Button
                    android:id="@+id/btnSubmit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Submit"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:backgroundTint="@color/colorPrimary" />


            </LinearLayout>
            <!-- Action Buttons -->
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
