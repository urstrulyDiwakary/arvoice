<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <RelativeLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/dim_12">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24dp"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/tvHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/dim_4"
            android:text="Leads"
            android:textColor="@color/black"
            android:textSize="@dimen/dim_16"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivEdit"
            android:layout_alignParentEnd="true"
            android:layout_width="wrap_content"
            android:layout_centerVertical="true"
            android:padding="10dp"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_edit_24"/>

    </RelativeLayout>

    <!-- Main Content with Floating Button Support -->
    <ScrollView
        android:layout_below="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:scrollbars="none"
        android:background="#F2F6F1">

        <LinearLayout
            android:id="@+id/llContentView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="LEAD INFO"
                        android:textStyle="bold"
                        android:layout_marginTop="@dimen/dim_16"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contact Name"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etContactName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />



                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mobile Number"
                        android:layout_marginTop="@dimen/dim_8"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">



                        <EditText
                            android:id="@+id/etMobileNumber"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />



                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/circle_button_bg"
                            android:padding="8dp"
                            android:src="@drawable/call"
                            app:tint="@color/white" />

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/circle_button_bg"
                            android:padding="8dp"
                            android:src="@drawable/whatsapp"
                            app:tint="@color/white" />

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/circle_button_bg"
                            android:padding="8dp"
                            android:src="@drawable/baseline_message_24"
                            app:tint="@color/white" />
                    </LinearLayout>

                    <!-- Repeat similar blocks for: Lead Owner, Alternate Number, Email, Revenue, etc. -->


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_marginTop="@dimen/dim_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lead Owner"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etLeadOwner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_marginTop="@dimen/dim_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Alternate Number"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etAlternate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_marginTop="@dimen/dim_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Email Address"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />




                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_marginTop="@dimen/dim_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Expected Revenue"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etExpectedRevenuew"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />




                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_marginTop="@dimen/dim_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Expected Closing Date"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etExpectedClosing"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:drawableTint="@color/colorPrimary"
                            android:drawableEnd="@drawable/baseline_calendar_month_24"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />



                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_marginTop="@dimen/dim_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lead Stage"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etLeadStage"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:drawableTint="@color/colorPrimary"
                            android:drawableEnd="@drawable/baseline_arrow_drop_down_24"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_marginTop="@dimen/dim_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etCategory"
                            android:focusableInTouchMode="false"
                            android:focusable="false"
                            android:drawableTint="@color/colorPrimary"
                            android:drawableEnd="@drawable/baseline_arrow_drop_down_24"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />




                    </LinearLayout>


                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Next Follow-Up Info"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/dim_16"
                        android:layout_height="wrap_content"
                        android:text="Next Follow-up On"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etFoolowUp"
                        android:drawableEnd="@drawable/baseline_calendar_month_24"
                        android:drawableTint="@color/colorPrimary"
                        android:focusableInTouchMode="false"
                        android:focusable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:paddingBottom="12dp">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dim_8"
                            android:text="Next Follow-up Notes"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/etFollowNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#000000"
                            android:textSize="16sp"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/dim_16"
                            android:paddingBottom="@dimen/dim_16"
                            android:background="?android:attr/editTextBackground" />



                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Update few words about this lead"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />




                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Source Info"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Lead Source"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etLeadSource"
                        android:focusableInTouchMode="false"
                        android:focusable="false"
                        android:drawableTint="@color/colorPrimary"
                        android:drawableEnd="@drawable/baseline_arrow_drop_down_24"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Campaign Name"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etCampaignName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Campaign Term"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etCampaignTerm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Campaign Content"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etetCampaignContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />


                </LinearLayout>


            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Last Call Info"
                        android:textAllCaps="true"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:paddingBottom="12dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Caller Name"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etCallerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Last Call Time"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etLastCall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />



                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Call Duration"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etCallDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Last Call Status"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etCallStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Reason for Not Connected"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/dim_16"
                        android:paddingBottom="@dimen/dim_16"
                        android:background="?android:attr/editTextBackground" />


                </LinearLayout>


            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>


    <ImageView
        android:id="@+id/ivAdd"
        android:layout_width="@dimen/dim_50"
        android:visibility="gone"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_height="@dimen/dim_50"
        android:layout_margin="@dimen/dim_16"
        android:src="@drawable/baseline_add_24"
        android:background="@drawable/plus_button_bg"
        android:padding="8dp"
        app:tint="@color/white" />
</RelativeLayout>
