<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/dim_12">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_24dp"
            app:tint="@color/black" />

        <TextView
            android:id="@+id/tvHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/dim_4"
            android:text="Create New Site Visit"
            android:textColor="@color/black"
            android:textSize="@dimen/dim_16"
            android:textStyle="bold" />



    </RelativeLayout>

    <ScrollView
        android:scrollbars="none"
        android:layout_below="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_above="@+id/btnSave"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:fontFamily="@font/poppins_regular"
                android:text="Site Visit Details"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_16" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/dim_12"
                android:background="@drawable/background_grey_curved"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:inputType="textCapSentences"
                android:paddingStart="@dimen/dim_12"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_14" />
            <!-- 1. Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/dim_12"
                android:fontFamily="@font/poppins_regular"
                android:text="Assigned To"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_16" />

            <EditText
                android:id="@+id/etAssignedTo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/dim_12"
                android:background="@drawable/background_grey_curved"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:drawableEnd="@drawable/user"
                android:drawableTint="@color/colorPrimary"
                android:focusable="false"
                android:paddingRight="@dimen/dim_12"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="textCapSentences"
                android:paddingStart="@dimen/dim_12"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_14" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/dim_12"
                android:fontFamily="@font/poppins_regular"
                android:text="Change Status"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_16" />

            <EditText
                android:id="@+id/etStatus"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/dim_12"
                android:background="@drawable/background_grey_curved"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:drawableEnd="@drawable/baseline_keyboard_arrow_down_24"
                android:drawableTint="@color/colorPrimary"
                android:focusable="false"
                android:paddingRight="@dimen/dim_12"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="textCapSentences"
                android:paddingStart="@dimen/dim_12"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_14" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/dim_12"
                android:fontFamily="@font/poppins_regular"
                android:text="Comments"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_16" />

            <EditText
                android:id="@+id/etComments"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="@dimen/dim_12"
                android:padding="@dimen/dim_12"
                android:background="@drawable/background_grey_curved"
                android:fontFamily="@font/poppins_regular"
                android:gravity="top|center_vertical"
                android:inputType="textCapSentences"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_14" />
            <!-- 2. Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/dim_12"
                android:fontFamily="@font/poppins_regular"
                android:text="Due Date"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_16" />

            <EditText
                android:id="@+id/etDueDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/dim_12"
                android:background="@drawable/background_grey_curved"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:drawableEnd="@drawable/baseline_calendar_month_24"
                android:drawableTint="@color/colorPrimary"
                android:focusable="false"
                android:paddingRight="@dimen/dim_12"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="text"
                android:paddingStart="@dimen/dim_12"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_14" />
            <!-- 3. Phone -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/dim_12"
                android:fontFamily="@font/poppins_regular"
                android:text="Due Time"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_16" />

            <EditText
                android:id="@+id/etDueTime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/dim_12"
                android:background="@drawable/background_grey_curved"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:drawableEnd="@drawable/baseline_access_time_24"
                android:drawableTint="@color/colorPrimary"
                android:focusable="false"
                android:paddingRight="@dimen/dim_12"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="text"
                android:paddingStart="@dimen/dim_12"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_14" />
            <!-- 4. Age -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/dim_12"
                android:fontFamily="@font/poppins_regular"
                android:text="Related Lead"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_16" />

            <EditText
                android:id="@+id/etRelatedLead"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="@dimen/dim_12"
                android:background="@drawable/background_grey_curved"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:drawableEnd="@drawable/leads"
                android:drawableTint="@color/colorPrimary"
                android:focusable="false"
                android:paddingRight="@dimen/dim_12"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:inputType="text"
                android:paddingStart="@dimen/dim_12"
                android:textColor="@color/black"
                android:textSize="@dimen/dim_14" />


        </LinearLayout>
    </ScrollView>

    <Button
        android:layout_alignParentBottom="true"
        android:id="@+id/btnSave"
        android:layout_marginHorizontal="@dimen/dim_16"
        android:layout_marginVertical="@dimen/dim_16"
        android:layout_gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="30dp"
        android:layout_centerHorizontal="true"
        android:text="Save"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="@dimen/dim_16"
        android:backgroundTint="@color/colorPrimary"
        android:background="@drawable/round_button" />

</RelativeLayout>
