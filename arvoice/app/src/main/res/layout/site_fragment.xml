<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <RelativeLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:paddingVertical="@dimen/dim_12">

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="@dimen/dim_40"
            android:layout_marginStart="@dimen/dim_12"
            android:layout_height="@dimen/dim_40"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_user" />

        <TextView
            android:id="@+id/tvHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:fontFamily="@font/poppins_medium"
            android:lineSpacingExtra="@dimen/dim_4"
            android:text="Site Visit"
            android:textColor="@color/black"
            android:textSize="@dimen/dim_16"
            android:textStyle="bold" />

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:queryHint="Search Here"
            android:layout_alignParentEnd="true"
            android:iconifiedByDefault="true"
            android:layout_alignParentTop="true"
            />
    </RelativeLayout>

    <FrameLayout
        android:id="@+id/filterIconContainer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@+id/topbar"
        android:layout_marginHorizontal="@dimen/dim_16">

        <ImageView
            android:id="@+id/ivFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_filter_alt_24"
            android:visibility="visible"
            android:contentDescription="Filter"
            app:tint="@color/colorPrimary" />

        <!-- Small green dot -->
        <View
            android:id="@+id/filterDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/green_circle"
            android:visibility="gone"/>
    </FrameLayout>


    <!-- Main Content with Floating Button Support -->
    <FrameLayout
        android:layout_below="@+id/filterIconContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="@dimen/dim_8"
                tools:listitem="@layout/lead_list_item"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>


        <ImageView
            android:id="@+id/fabAddLead"
            android:layout_width="@dimen/dim_50"
            android:layout_gravity="end|bottom"
            android:layout_height="@dimen/dim_50"
            android:layout_marginTop="@dimen/dim_16"
            android:layout_marginHorizontal="@dimen/dim_16"
            android:layout_marginBottom="@dimen/dim_50"
            android:src="@drawable/baseline_add_24"
            android:background="@drawable/plus_button_bg"
            android:padding="8dp"
            app:tint="@color/white" />
    </FrameLayout>
    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No data found"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:layout_marginTop="@dimen/dim_16"
        android:layout_marginHorizontal="@dimen/dim_16"
        android:layout_marginBottom="@dimen/dim_80"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:fontFamily="@font/poppins_medium"
        android:textStyle="bold"/>

</RelativeLayout>
