<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Assignment" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/black</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
    </style>
    <style name="LoginTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Set status bar color -->
        <item name="android:statusBarColor">@android:color/black</item>
        <!-- Optionally set navigation bar color -->
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="MyDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="MainTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Set status bar color -->
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <!-- Optionally set navigation bar color -->
        <item name="android:navigationBarColor">@color/colorPrimary</item>
    </style>
    <style name="Toolbar.WhiteArrow.WhiteText" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="android:homeAsUpIndicator">@drawable/ic_left_arrow_white</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="MyDatePickerDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <!-- Change accent color -->
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:background">#FFFFFF</item>
    </style>
    <style name="DialerButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
    </style>
    <style name="RoundedRectangleImageStyle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item> <!-- You can adjust radius -->
    </style>





</resources>