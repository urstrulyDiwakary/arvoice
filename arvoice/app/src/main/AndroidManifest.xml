<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.arvoice">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />


    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <uses-permission
        android:name="android.permission.READ_CALL_LOG"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <queries>
        <!-- Let your app query if WhatsApp is installed -->
        <package android:name="com.whatsapp" />
    </queries>

    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <application
        android:name="com.arvoice.base.AppController"
        android:allowBackup="true"
        android:appComponentFactory="some.new.value"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assignment"
        android:usesCleartextTraffic="true"
        tools:replace="android:appComponentFactory"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu">

        <service
            android:name=".fcm.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <activity
            android:name="com.arvoice.activity.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>
        </activity>
        <activity android:name="com.arvoice.activity.LoginActivity"
            android:theme="@style/LoginTheme"/>
        <activity android:name="com.arvoice.activity.DispositionActivity"
            android:theme="@style/LoginTheme"/>
        <activity
            android:name="com.arvoice.profile.UserDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity
            android:name="com.arvoice.profile.BlockListActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity
            android:name="com.arvoice.profile.ManualSyncActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity
            android:name="com.arvoice.profile.SimCardManagerActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity android:name="com.arvoice.activity.EditTasksActivity"
            android:theme="@style/LoginTheme"/>
        <activity android:name="com.arvoice.activity.SelectLeadActivity"
            android:theme="@style/LoginTheme"/>
        <activity android:name="com.arvoice.activity.AddTasksActivity"
            android:theme="@style/LoginTheme"/>
        <activity android:name="com.arvoice.activity.DashboardActivity"
            android:theme="@style/LoginTheme"/>
        <activity android:name="com.arvoice.activity.TransitionActivity"
            android:theme="@style/LoginTheme"/>
        <activity android:name="com.arvoice.activity.SelectUserActivity"
            android:theme="@style/LoginTheme"/>

        <activity android:name="com.arvoice.activity.AddLeadsActivity"
            android:theme="@style/LoginTheme"/>
        <activity android:name="com.arvoice.activity.EditLeadsActivity"
            android:theme="@style/LoginTheme"/>
        <activity android:name="com.arvoice.activity.UpdateLeadsActivity"
            android:theme="@style/LoginTheme"/><activity android:name="com.arvoice.activity.ContactDetailsActivity"
            android:theme="@style/LoginTheme"/>


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.apppay.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>


    </application>

</manifest>
